menu "KernelSU"

config KSU
	tristate "KernelSU function support"
	depends on KPROBES && EXT4_FS
	default y
	help
	  Enable kernel-level root privileges on Android System.
	  Requires CONFIG_KPROBES for kernel hooking support.
	  Requires CONFIG_EXT4_FS for `ext4_unregister_sysfs`.
	  To compile as a module, choose M here: the
	  module will be called kernelsu.

config KSU_DEBUG
	bool "KernelSU debug mode"
	depends on KSU
	default n
	help
	  Enable KernelSU debug mode.

config KSU_MANUAL_SU
    bool "Use manual su"
    depends on KSU
    default y
    help
      Use manual su and authorize the corresponding command line and application via prctl

config KPM
    bool "Enable KazeSU KPM"
    depends on KSU && 64BIT
    default n
    help
      Enabling this option will activate the KPM feature of KazeSU.
      This option is suitable for scenarios where you need to force KPM to be enabled.
      but it may affect system stability.
    select KALLSYMS
    select KALLSYMS_ALL

config KSU_DISABLE_MANAGER
	bool "Disable KernelSU manager integration"
	depends on KSU
	default n
	help
	  Disable manager APK detection and manager-specific handling.
	  Root will be used in place of manager-only functionality.

config KSU_DISABLE_POLICY
	bool "Disable KernelSU policy profiles"
	depends on KSU
	default n
	help
	  Disable per-app root/non-root profile customization.
	  Escalation will always use the default full root profile, and
	  non-root handling will follow the global umount policy only.

config KSU_X86_PATCH_SYSCALL_DISPATCHER
	bool "Dynamically patch x64's hardened syscall dispatcher to support syscall hooks"
	depends on KSU && X86_64
	default n
	help
	  Dynamically patch x64's hardened syscall dispatcher to support syscall hooks. This is a
	  replacement for a kernel source code patch, and is useful for x86_64 LKM mode.

config KSU_STEALTH
	bool "KazeSU stealth mode"
	depends on KSU
	default y
	help
	  While the stealth switch is on, GET_INFO stops reporting
	  KSU_GET_INFO_FLAG_MANAGER so the manager app looks "not installed".
	  Real permission checks and the crowned manager are unchanged, so the
	  manager (or root) can always toggle it back. State is persisted at
	  /data/adb/ksu/stealth and reloaded on POST_FS_DATA.

config KSU_KPROBES_HIDE
	bool "KazeSU KPROBES hook hiding (experimental, default off)"
	depends on KSU
	default n
	help
	  Report only the generic tracepoint backend through GET_HOOK_TYPE
	  instead of the syscall-redirect detail. KPROBES shares probe slots
	  with KPM; turn this on only after validating KPM coexistence.



menu "KernelSU - SUSFS"

config KSU_SUSFS
        bool "KernelSU SUSFS support"
        depends on KSU
        default y
        help
          Enable SUSFS integration in KernelSU.

config KSU_SUSFS_PRIORITY_UID_FILTER
        bool "SUSFS priority UID filter"
        depends on KSU_SUSFS
        default y
        help
          Enable priority UID filtering for SUSFS operations.

config KSU_SUSFS_SUS_PATH
        bool "SUSFS suspicious path hiding"
        depends on KSU_SUSFS
        default y
        help
          Enable hiding configured suspicious paths.

config KSU_SUSFS_SUS_MOUNT
        bool "SUSFS suspicious mount hiding"
        depends on KSU_SUSFS
        default y
        help
          Enable hiding configured suspicious mounts.

config KSU_SUSFS_SUS_KSTAT
        bool "SUSFS suspicious kstat spoofing"
        depends on KSU_SUSFS
        default y
        help
          Enable spoofing of configured file and directory kstat data.

config KSU_SUSFS_SPOOF_UNAME
        bool "SUSFS uname spoofing"
        depends on KSU_SUSFS
        default y
        help
          Enable uname output spoofing.

config KSU_SUSFS_ENABLE_LOG
        bool "SUSFS kernel logging"
        depends on KSU_SUSFS
        default y
        help
          Enable SUSFS kernel log messages.

config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
        bool "Hide KernelSU and SUSFS symbols"
        depends on KSU_SUSFS
        default y
        help
          Hide KernelSU and SUSFS symbols from kallsyms.

config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
        bool "SUSFS cmdline or bootconfig spoofing"
        depends on KSU_SUSFS
        default y
        help
          Enable spoofing of proc cmdline or bootconfig output.

config KSU_SUSFS_OPEN_REDIRECT
        bool "SUSFS open redirect"
        depends on KSU_SUSFS
        default y
        help
          Enable configured path redirection for open operations.

config KSU_SUSFS_SUS_MAP
        bool "SUSFS suspicious memory map hiding"
        depends on KSU_SUSFS
        default y
        help
          Enable hiding configured mapped files from proc map interfaces.

endmenu

endmenu
